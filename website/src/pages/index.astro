---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
---

<BaseLayout
  title="Crown Heights Academy | Private Secondary School in Benin City"
  description="Crown Heights Academy is a private secondary school in Benin City, Nigeria, offering JSS 1 to SS 3. Admissions are open for the 2027/2028 session."
>
  <section class="hero">
    <div class="container hero-inner">
      <div>
        <p class="hero-badge">Admissions open for 2027/2028</p>
        <h1>
          Welcome to
          <span class="hero-school">Crown Heights Academy</span>
        </h1>
        <p class="hero-lead">
          A caring private secondary school in Benin City, Nigeria. We help
          young people grow in confidence, character and achievement — from
          JSS 1 to SS 3.
        </p>
        <div class="button-row">
          <a class="btn btn--gold" href="/admissions">
            Apply now <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn btn--outline-light" href="/about">
            Discover our school
          </a>
        </div>
      </div>

      <aside class="hero-card" aria-label="Admissions at a glance">
        <p class="hero-card-label">Admissions at a glance</p>
        <h2>Join us for the 2027/2028 session</h2>
        <dl class="fact-list">
          <div>
            <dt>Classes</dt>
            <dd>JSS 1 – SS 3</dd>
          </div>
          <div>
            <dt>Application fee</dt>
            <dd>₦5,000</dd>
          </div>
          <div>
            <dt>Entrance exam</dt>
            <dd>Saturday, 16 January 2027</dd>
          </div>
        </dl>
        <a class="btn btn--primary" href="/admissions">See how to apply</a>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">Welcome to our school</p>
        <h2>A place where every child is known and encouraged</h2>
        <p class="lead">
          Crown Heights Academy is a private secondary school in Benin City,
          Edo State. We offer a complete secondary education for students in
          JSS 1 to SS 3.
        </p>
        <p>
          Our teachers combine strong classroom teaching with genuine care for
          each student. We want every child to feel safe, try their best and
          leave us ready for the next step in life. Parents are an important
          part of that journey, and we keep communication simple and clear.
        </p>
        <a class="text-link" href="/about">
          Read our story <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="quick-grid">
        <div class="quick-card">
          <strong>JSS 1 – SS 3</strong>
          <span>A complete six-year secondary education under one roof.</span>
        </div>
        <div class="quick-card">
          <strong>Caring teachers</strong>
          <span>Supportive teaching that helps every learner make progress.</span>
        </div>
        <div class="quick-card">
          <strong>Parent partnership</strong>
          <span>Clear updates and open communication with families.</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">Why families choose us</p>
        <h2>Academic strength, wrapped in care</h2>
        <p class="lead">
          We believe a good school builds both a sharp mind and a strong
          character. These are the things we focus on every day.
        </p>
      </div>

      <div class="card-grid card-grid--3">
        <article class="feature-card">
          <span class="feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v17H6.5A2.5 2.5 0 0 0 4 21.5v-17Z"></path>
              <path d="M4 21.5A2.5 2.5 0 0 1 6.5 19H20"></path>
              <path d="M8 6h8M8 10h6"></path>
            </svg>
          </span>
          <h3>Strong foundations</h3>
          <p>
            Clear teaching, steady practice and regular feedback help students
            build real understanding in every subject.
          </p>
        </article>

        <article class="feature-card">
          <span class="feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z"></path>
            </svg>
          </span>
          <h3>Character that lasts</h3>
          <p>
            Respect, honesty and responsibility are part of school life, not
            just words on a wall.
          </p>
        </article>

        <article class="feature-card">
          <span class="feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </span>
          <h3>A community that cares</h3>
          <p>
            Students, teachers and parents work together in a calm, friendly
            environment where everyone belongs.
          </p>
        </article>
      </div>
    </div>
  </section>

  <CtaBand />

  <section class="section">
    <div class="container">
      <div class="section-head-row">
        <div class="section-head">
          <p class="eyebrow">News &amp; notices</p>
          <h2>The latest from our school</h2>
        </div>
        <a class="text-link" href="/news">
          View all news <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="news-grid">
        <article class="news-card">
          <div class="news-meta">
            <span class="tag tag--gold">Admissions</span>
            <time datetime="2026-11-02">2 November 2026</time>
          </div>
          <h3>Admissions open for 2027/2028</h3>
          <p>
            Applications are now open for JSS 1 to SS 3. The application fee is
            ₦5,000 and the entrance exam holds on Saturday, 16 January 2027.
          </p>
          <a class="text-link" href="/news#admissions-open">
            Read notice <span aria-hidden="true">→</span>
          </a>
        </article>

        <article class="news-card">
          <div class="news-meta">
            <span class="tag">Entrance exam</span>
            <time datetime="2026-10-28">28 October 2026</time>
          </div>
          <h3>Entrance exam date confirmed</h3>
          <p>
            The entrance exam for new students will take place on Saturday,
            16 January 2027. The school office will share more details after
            you apply.
          </p>
          <a class="text-link" href="/news#entrance-exam">
            Read notice <span aria-hidden="true">→</span>
          </a>
        </article>

        <article class="news-card">
          <div class="news-meta">
            <span class="tag">Parents</span>
            <time datetime="2026-10-21">21 October 2026</time>
          </div>
          <h3>Keep your contact details up to date</h3>
          <p>
            Please confirm your phone number and email address with the school
            office so that important notices reach you without delay.
          </p>
          <a class="text-link" href="/news#contact-details">
            Read notice <span aria-hidden="true">→</span>
          </a>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
